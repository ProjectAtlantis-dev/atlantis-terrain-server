+  // Floor between movement-triggered dispatches. Without it, sustained fast
+  // flight (>10 m per frame) re-submits the full density march every frame —
+  // one large ingredient of the flythrough freeze. Cloud shadows lagging a
+  // few frames behind a fast camera is invisible; a per-frame ~39 M-sample
+  // dispatch is not.
+  minDispatchInterval = 10
   /** Diagnostic: number of compute dispatches actually submitted. */
   dispatchCount = 0
 
