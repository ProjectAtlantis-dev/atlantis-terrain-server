     return super.setup(builder)
   }
 
-  override updateBefore(frame: NodeFrame): void {
+  // When managed externally (autoDispatch = false), the owner must call
+  // dispatch(renderer) from the application loop OUTSIDE the frame: in-frame
+  // compute submits race the first-frame pipeline builds on three r182 and
+  // nondeterministically corrupt unrelated passes (e.g. atmosphere LUTs ->
+  // black sky).
+  autoDispatch = true
+
+  dispatch(renderer: { compute: (node: never) => unknown }): void {
     if (this.computeDispatched || this.computeNode == null) {
       return
     }
     this.computeDispatched = true
-    void frame.renderer!.compute(this.computeNode as never)
+    void renderer.compute(this.computeNode as never)
+  }
+
+  override updateBefore(frame: NodeFrame): void {
+    if (this.autoDispatch) {
+      this.dispatch(frame.renderer as never)
+    }
   }
 
   override dispose(): void {
