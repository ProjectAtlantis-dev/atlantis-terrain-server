+// TSL port of shaders/structuredSampling.glsl
+// Implements Structured Volume Sampling:
+// https://github.com/huwb/volsample
+// Implementation reference: https://www.shadertoy.com/view/ttVfDc
+//
+// These helpers compose nodes inline (plain functions, not Fn) because they
+// produce multiple outputs; TSL inlines the resulting graph.
+
+import { abs, dot, exp, mod, select, sign, vec3, vec4 } from 'three/tsl'
+
+import type { Node } from '@takram/three-geospatial/webgpu'
+
+function getIcosahedralVertices(direction: Node<'vec3'>): {
+  v1: Node<'vec3'>
+  v2: Node<'vec3'>
+  v3: Node<'vec3'>
+} {
+  // Normalization scalers to fit dodecahedron to unit sphere.
+  const a = 0.85065080835204 // phi / sqrt(2 + phi)
+  const b = 0.5257311121191336 // 1 / sqrt(2 + phi)
+
+  // Derive the vertices of icosahedron where triangle intersects the
+  // direction. See: https://www.ppsloan.org/publications/AmbientDice.pdf
+  const kT = 0.6180339887498948 // 1 / phi
+  const kT2 = 0.38196601125010515 // 1 / phi^2
+  const absD = abs(direction).toConst()
+  const selector1 = dot(absD, vec3(1, kT2, -kT))
+  const selector2 = dot(absD, vec3(-kT, 1, kT2))
+  const selector3 = dot(absD, vec3(kT2, -kT, 1))
+  const octantSign = sign(direction).toConst()
+  return {
+    v1: selector1
+      .greaterThan(0)
+      .select(vec3(a, b, 0), vec3(-b, 0, a))
+      .mul(octantSign)
+      .toConst('icoV1'),
+    v2: selector2
+      .greaterThan(0)
+      .select(vec3(0, a, b), vec3(a, -b, 0))
+      .mul(octantSign)
+      .toConst('icoV2'),
+    v3: selector3
+      .greaterThan(0)
+      .select(vec3(b, 0, a), vec3(0, a, -b))
+      .mul(octantSign)
+      .toConst('icoV3')
+  }
+}
+
+const sortKey = (v: Node<'vec3'>): Node<'float'> => dot(v, vec3(0.5, 0.5, 1))
+
+export function getStructureNormal(
+  direction: Node<'vec3'>,
+  jitter: Node<'float'>
+): Node<'vec3'> {
+  const { v1, v2, v3 } = getIcosahedralVertices(direction)
+
+  // Three-element sorting network on dot(v, base), mirroring sortVertices().
+  const aw0 = vec4(v1, sortKey(v1)).toConst()
+  const bw0 = vec4(v2, sortKey(v2)).toConst()
+  const cw0 = vec4(v3, sortKey(v3)).toConst()
+  const s1 = aw0.w.greaterThan(bw0.w).toConst()
+  const aw1 = select(s1, bw0, aw0).toConst()
+  const bw1 = select(s1, aw0, bw0).toConst()
+  const s2 = bw1.w.greaterThan(cw0.w).toConst()
+  const bw2 = select(s2, cw0, bw1).toConst()
+  const cw2 = select(s2, bw1, cw0).toConst()
+  const s3 = aw1.w.greaterThan(bw2.w).toConst()
+  const a = select(s3, bw2, aw1).xyz.toConst('sortedA')
+  const b = select(s3, aw1, bw2).xyz.toConst('sortedB')
+  const c = cw2.xyz.toConst('sortedC')
+
+  // Pentagonal weights
+  const w = exp(
+    vec3(dot(a, direction), dot(b, direction), dot(c, direction)).mul(40)
+  ).toConst()
+  const weights = w.div(w.x.add(w.y).add(w.z)).toConst('pentagonalWeights')
+
+  return select(
+    jitter.lessThan(weights.x),
+    a,
+    select(jitter.lessThan(weights.x.add(weights.y)), b, c)
+  ).toConst('structureNormal')
+}
+
+// Reference: https://github.com/huwb/volsample/blob/master/src/unity/Assets/Shaders/RayMarchCore.cginc
+export function intersectStructuredPlanes(
+  normal: Node<'vec3'>,
+  rayOrigin: Node<'vec3'>,
+  rayDirection: Node<'vec3'>,
+  samplePeriod: Node<'float'>
+): { stepOffset: Node<'float'>; stepSize: Node<'float'> } {
+  const NoD = dot(rayDirection, normal).toConst('NoD')
+  const stepSize = samplePeriod.div(abs(NoD)).toConst('structuredStepSize')
+
+  // Skips leftover bit to get from rayOrigin to first strata plane. mod()
+  // gives different results depending on the sign of the argument; ensure
+  // the first sample is in front of the viewer.
+  const offset = mod(dot(rayOrigin, normal), samplePeriod)
+    .div(NoD)
+    .negate()
+    .toConst()
+  const stepOffset = select(offset.lessThan(0), offset.add(stepSize), offset)
+    .toConst('structuredStepOffset')
+
+  return { stepOffset, stepSize }
+}
