+  const n1W = mix(
+    vec4(n0010, n1010, n0110, n1110),
+    vec4(n0011, n1011, n0111, n1111),
+    fadeXYZW.w
+  )
+  const nZW = mix(n0W, n1W, fadeXYZW.z)
+  const nYZW = mix(nZW.xy, nZW.zw, fadeXYZW.y)
+  const nXYZW = mix(nYZW.x, nYZW.y, fadeXYZW.x)
+  return mul(2.2, nXYZW)
+})
