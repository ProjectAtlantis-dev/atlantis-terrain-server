diff --git a/packages/clouds/src/webgpu/CloudBeerShadowMapNode.ts b/packages/clouds/src/webgpu/CloudBeerShadowMapNode.ts
new file mode 100644
index 00000000..07282b90
--- /dev/null
+++ b/packages/clouds/src/webgpu/CloudBeerShadowMapNode.ts
@@ -0,0 +1,511 @@
+// TSL/WebGPU port of the beer shadow map pass (ShadowPass/ShadowMaterial +
+// shaders/shadow.frag): cloud optical depth marched from the sun through the
+// cloud layers into cascaded shadow maps fitted to the camera frustum.
+//
+// Differences from the WebGL implementation:
+// - Renders via a compute dispatch into one Storage3DTexture layer per
+//   cascade instead of an MRT fragment pass.
+// - No temporal resolve yet: jitter comes from static interleaved gradient
+//   noise instead of STBN, and there is no history reprojection. Structured
+//   volume sampling keeps the result temporally stable regardless.
+
+import {
+  HalfFloatType,
+  LinearFilter,
+  Matrix3,
+  Matrix4,
+  RGBAFormat,
+  Vector2,
+  Vector3,
+  type PerspectiveCamera
+} from 'three'
+import {
+  Break,
+  Continue,
+  Fn,
+  If,
+  Loop,
+  Return,
+  clamp,
+  exp,
+  float,
+  greaterThan,
+  instanceIndex,
+  int,
+  ivec3,
+  length,
+  max,
+  min,
+  normalize,
+  saturate,
+  select,
+  renderGroup,
+  textureStore,
+  uniform,
+  uniformArray,
+  uvec3,
+  vec2,
+  vec3,
+  vec4
+} from 'three/tsl'
+import {
+  NodeUpdateType,
+  Storage3DTexture,
+  TempNode,
+  type NodeBuilder,
+  type NodeFrame,
+  type TextureNode
+} from 'three/webgpu'
+
+import {
+  getAtmosphereContext,
+  type AtmosphereContext
+} from '@takram/three-atmosphere/webgpu'
+import {
+  FnVar,
+  interleavedGradientNoise,
+  outputTexture3D,
+  raySphereIntersection,
+  type Node
+} from '@takram/three-geospatial/webgpu'
+
+import { CascadedShadowMaps } from '../CascadedShadowMaps'
+import type { CloudDensityField } from './CloudDensityField'
+import {
+  getStructureNormal,
+  intersectStructuredPlanes
+} from './structuredSampling'
+
+const MAP_SIZE = 512
+const CASCADE_COUNT = 3
+
+const rotationScratch = /*#__PURE__*/ new Matrix3()
+const vectorScratch = /*#__PURE__*/ new Vector3()
+
+export class CloudBeerShadowMapNode extends TempNode {
+  static override get type(): string {
+    return 'CloudBeerShadowMapNode'
+  }
+
+  camera: PerspectiveCamera
+  readonly densityField: CloudDensityField
+
+  readonly csm = new CascadedShadowMaps({
+    cascadeCount: CASCADE_COUNT,
+    mapSize: new Vector2(MAP_SIZE, MAP_SIZE),
+    margin: 7000,
+    fade: false
+  })
+
+  // Primary raymarch parameters (defaults from qualityPresets.shadow).
+  readonly maxIterationCount = 50 // Baked into the shader
+  readonly minStepSize = uniform(100).setGroup(renderGroup)
+  readonly maxStepSize = uniform(1000).setGroup(renderGroup)
+  readonly minDensity = uniform(1e-5).setGroup(renderGroup)
+  readonly minExtinction = uniform(1e-5).setGroup(renderGroup)
+  readonly minTransmittance = uniform(1e-4).setGroup(renderGroup)
+  readonly opticalDepthTailScale = uniform(2).setGroup(renderGroup)
+
+  private readonly inverseShadowMatrices = uniformArray(
+    Array.from({ length: CASCADE_COUNT }, () => new Matrix4()),
+    'mat4'
+  )
+  private readonly shadowMatrices = uniformArray(
+    Array.from({ length: CASCADE_COUNT }, () => new Matrix4()),
+    'mat4'
+  )
+
+  readonly texture = new Storage3DTexture(MAP_SIZE, MAP_SIZE, CASCADE_COUNT)
+
+  // Recompute cadence: the map refreshes when the sun moves or the camera
+  // leaves the fitted cascades, and at most every `updateInterval` frames
+  // otherwise (there is no temporal accumulation to feed every frame).
+  updateInterval = 30
+  /** Diagnostic: number of compute dispatches actually submitted. */
+  dispatchCount = 0
+
+  private readonly textureNode: TextureNode
+  private atmosphereContext?: AtmosphereContext
+  private computeNode?: unknown
+  private framesSinceDispatch = Infinity
+  private readonly lastSunDirection = new Vector3()
+  private readonly lastCameraPosition = new Vector3()
+
+  constructor(camera: PerspectiveCamera, densityField: CloudDensityField) {
+    super(null)
+    this.camera = camera
+    this.densityField = densityField
+
+    this.texture.type = HalfFloatType
+    this.texture.format = RGBAFormat
+    this.texture.minFilter = LinearFilter
+    this.texture.magFilter = LinearFilter
+    this.texture.generateMipmaps = false
+    this.texture.name = 'CloudBeerShadowMapNode'
+
+    this.textureNode = outputTexture3D(this, this.texture)
+  }
+
+  getTextureNode(): TextureNode {
+    return this.textureNode
+  }
+
+  get maxFar(): number | null {
+    return this.csm.maxFar
+  }
+
+  set maxFar(value: number | null) {
+    this.csm.maxFar = value
+  }
+
+  // Call from the application render loop, BEFORE renderer.render /
+  // postProcessing.render. Submitting the compute from inside the frame
+  // (setup or updateBefore) interleaves a command submission with the
+  // in-flight render graph on three r182 and corrupts unrelated passes
+  // (observed: epipolar god-ray internals — black frames).
+  update(renderer: { compute: (node: never) => unknown }): void {
+    const context = this.atmosphereContext
+    if (context == null || this.computeNode == null) {
+      return // Not built yet.
+    }
+
+    // Sun direction in world space (matrixWorldToECEF is a rigid transform;
+    // same workaround as AtmosphereLightNode: nothing updates
+    // matrixECEFToWorld in the node graph).
+    const sunDirectionWorld = vectorScratch
+      .copy(context.sunDirectionECEF.value)
+      .applyMatrix3(
+        rotationScratch
+          .setFromMatrix4(context.matrixWorldToECEF.value)
+          .transpose()
+      )
+
+    ++this.framesSinceDispatch
+    const sunMoved =
+      this.lastSunDirection.distanceToSquared(sunDirectionWorld) > 1e-8
+    const cameraMoved =
+      this.lastCameraPosition.distanceToSquared(this.camera.position) > 100
+    if (
+      !sunMoved &&
+      !cameraMoved &&
+      this.framesSinceDispatch < this.updateInterval
+    ) {
+      return
+    }
+    this.framesSinceDispatch = 0
+    this.lastSunDirection.copy(sunDirectionWorld)
+    this.lastCameraPosition.copy(this.camera.position)
+    this.dispatchCount += 1
+
+    this.csm.update(this.camera, sunDirectionWorld)
+
+    const cascades = this.csm.cascades
+    const inverseMatrices = this.inverseShadowMatrices.array as Matrix4[]
+    const matrices = this.shadowMatrices.array as Matrix4[]
+    for (let i = 0; i < CASCADE_COUNT; ++i) {
+      inverseMatrices[i].copy(cascades[i].inverseMatrix)
+      matrices[i].copy(cascades[i].matrix)
+    }
+
+    void renderer.compute(this.computeNode as never)
+  }
+
+  override setup(builder: NodeBuilder): unknown {
+    const context = getAtmosphereContext(builder)
+    this.atmosphereContext = context
+
+    const density = this.densityField
+    const bottomRadius = float(context.parameters.bottomRadius)
+    const sunDirectionECEF = context.sunDirectionECEF
+    const { matrixWorldToECEF, altitudeCorrectionECEF } = context
+
+    const computeNode = Fn(() => {
+      const id = instanceIndex
+      const x = id.mod(MAP_SIZE)
+      const y = id.div(MAP_SIZE).mod(MAP_SIZE)
+      const cascade = id.div(MAP_SIZE * MAP_SIZE)
+      If(uvec3(x, y, cascade).greaterThanEqual(uvec3(MAP_SIZE, MAP_SIZE, CASCADE_COUNT)).any(), () => {
+        Return()
+      })
+
+      const uv = vec2(float(x).add(0.5), float(y).add(0.5))
+        .div(MAP_SIZE)
+        .toConst('shadowUv')
+      const clip = uv.mul(2).sub(1).toConst()
+
+      const pointClip = this.inverseShadowMatrices
+        .element(cascade)
+        .mul(vec4(clip.x, clip.y, -1, 1))
+        .toConst()
+      const point = pointClip.xyz.div(pointClip.w).toConst('shadowPoint')
+      const sunPosition = matrixWorldToECEF
+        .mul(vec4(point, 1))
+        .xyz.add(altitudeCorrectionECEF)
+        .toConst('sunPosition')
+
+      const rayDirection = normalize(sunDirectionECEF.negate()).toConst(
+        'shadowRayDirection'
+      )
+
+      // Ray interval between the shadow-top and shadow-bottom spheres.
+      const topIntersection = raySphereIntersection(
+        sunPosition,
+        rayDirection,
+        vec3(0),
+        bottomRadius.add(density.shadowTopHeight)
+      ).toConst()
+      const bottomIntersection = raySphereIntersection(
+        sunPosition,
+        rayDirection,
+        vec3(0),
+        bottomRadius.add(density.shadowBottomHeight)
+      ).toConst()
+      const rayNear = max(0, topIntersection.x).toConst('shadowRayNear')
+      const rayFar = select(
+        bottomIntersection.x.lessThan(0),
+        1e6,
+        bottomIntersection.x
+      ).toConst('shadowRayFar')
+      const maxRayDistance = rayFar.sub(rayNear).toConst('maxRayDistance')
+
+      const rayOrigin = rayDirection
+        .mul(rayNear)
+        .add(sunPosition)
+        .toConst('shadowRayOrigin')
+
+      const jitter = interleavedGradientNoise(vec2(float(x), float(y))).toConst(
+        'shadowJitter'
+      )
+
+      // Structured volume sampling: spatially aliased but temporally stable,
+      // which matters most at shadow map resolutions.
+      const normal = getStructureNormal(rayDirection, jitter)
+      const { stepOffset, stepSize } = intersectStructuredPlanes(
+        normal,
+        rayOrigin,
+        rayDirection,
+        clamp(
+          maxRayDistance.div(this.maxIterationCount),
+          this.minStepSize,
+          this.maxStepSize
+        )
+      )
+
+      const rayDistance = stepOffset.toVar('rayDistance')
+      const extinctionSum = float(0).toVar('extinctionSum')
+      const maxOpticalDepth = float(0).toVar('maxOpticalDepth')
+      const maxOpticalDepthTail = float(0).toVar('maxOpticalDepthTail')
+      const transmittanceIntegral = float(1).toVar('transmittanceIntegral')
+      const weightedDistanceSum = float(0).toVar('weightedDistanceSum')
+      const transmittanceSum = float(0).toVar('transmittanceSum')
+      const sampleCount = int(0).toVar('sampleCount')
+
+      Loop(this.maxIterationCount, () => {
+        If(rayDistance.greaterThan(maxRayDistance), () => {
+          Break()
+        })
+
+        const position = rayDirection
+          .mul(rayDistance)
+          .add(rayOrigin)
+          .toConst('marchPosition')
+        const height = length(position).sub(bottomRadius).toConst('height')
+
+        If(density.insideLayerIntervals(height), () => {
+          rayDistance.addAssign(stepSize)
+          Continue()
+        })
+
+        const globeUv = density.getGlobeUv(position)
+        const weather = density.sampleWeather(globeUv, height, { shadow: true })
+
+        If(greaterThan(weather.density, vec4(this.minDensity)).any(), () => {
+          // Note this assumes an homogeneous medium.
+          const media = density.sampleMedia(weather, position, globeUv)
+          If(media.extinction.greaterThan(this.minExtinction), () => {
+            extinctionSum.addAssign(media.extinction)
+            maxOpticalDepth.addAssign(media.extinction.mul(stepSize))
+            transmittanceIntegral.mulAssign(
+              exp(media.extinction.negate().mul(stepSize))
+            )
+            weightedDistanceSum.addAssign(
+              rayDistance.mul(transmittanceIntegral)
+            )
+            transmittanceSum.addAssign(transmittanceIntegral)
+            sampleCount.addAssign(1)
+          })
+        })
+
+        If(transmittanceIntegral.lessThanEqual(this.minTransmittance), () => {
+          // A large amount of optical depth accumulates in the tail, beyond
+          // the point of minimum transmittance. The expected optical depth
+          // seems to decrease exponentially with the number of samples taken
+          // before reaching the minimum transmittance.
+          // https://x.com/shotamatsuda/status/1886259549931520437
+          maxOpticalDepthTail.assign(
+            min(
+              this.opticalDepthTailScale
+                .mul(stepSize)
+                .mul(exp(float(1).sub(float(sampleCount)))),
+              stepSize.mul(0.5) // Excess optical depth only adds aliasing.
+            )
+          )
+          Break()
+        })
+        rayDistance.addAssign(stepSize)
+      })
+
+      const result = select(
+        sampleCount.equal(0),
+        vec4(maxRayDistance, 0, 0, 0),
+        vec4(
+          min(weightedDistanceSum.div(transmittanceSum), maxRayDistance),
+          extinctionSum.div(float(sampleCount)),
+          maxOpticalDepth,
+          maxOpticalDepthTail
+        )
+      ).toConst('shadowResult')
+
+      textureStore(this.texture, ivec3(int(x), int(y), int(cascade)), result)
+    })().compute(MAP_SIZE * MAP_SIZE * CASCADE_COUNT, [8, 8, 1])
+
+    this.computeNode = computeNode
+
+    return super.setup(builder)
+  }
+
+  // Optical depth of the clouds shadowing `positionECEF`, reconstructed from
+  // the beer shadow map (see clouds.frag readShadowOpticalDepth):
+  //   od = min(maxOD + tail, meanExtinction * max(0, dTop - offset - front))
+  sampleOpticalDepth(
+    positionECEF: Node<'vec3'>,
+    distanceOffset: Node<'float'> | number = 0
+  ): Node<'float'> {
+    const density = this.densityField
+
+    return FnVar(() => (builder: NodeBuilder) => {
+      const context = getAtmosphereContext(builder)
+      const bottomRadius = float(context.parameters.bottomRadius)
+      const { matrixWorldToECEF, altitudeCorrectionECEF, sunDirectionECEF } =
+        context
+
+      const position = positionECEF.toConst('shadowSamplePositionECEF')
+      const topIntersection = raySphereIntersection(
+        position,
+        sunDirectionECEF,
+        vec3(0),
+        bottomRadius.add(density.shadowTopHeight)
+      ).toConst()
+      const distanceToTop = topIntersection.y.toConst('distanceToShadowTop')
+
+      const result = float(0).toVar('shadowOpticalDepth')
+      If(distanceToTop.greaterThan(0), () => {
+        // World position for the cascade projection. matrixWorldToECEF is
+        // rigid, so its transpose rotation + negated translation inverts it;
+        // in this codebase the world already is ECEF (identity), keep the
+        // altitude correction only.
+        const world = position.sub(altitudeCorrectionECEF).toConst()
+
+        // First-fit cascade selection: use the finest cascade whose map
+        // contains the point.
+        const uvs: Array<Node<'vec2'>> = []
+        for (let i = 0; i < CASCADE_COUNT; ++i) {
+          const clip = this.shadowMatrices.element(i).mul(vec4(world, 1))
+          uvs.push(clip.xy.div(clip.w).mul(0.5).add(0.5).toConst())
+        }
+        const inside = uvs.map(uv =>
+          uv.x
+            .greaterThanEqual(0)
+            .and(uv.x.lessThanEqual(1))
+            .and(uv.y.greaterThanEqual(0))
+            .and(uv.y.lessThanEqual(1))
+            .toConst()
+        )
+
+        const cascadeIndex = select(
+          inside[0],
+          0,
+          select(inside[1], 1, select(inside[2], 2, -1))
+        ).toConst('cascadeIndex')
+        const uv = select(
+          inside[0],
+          uvs[0],
+          select(inside[1], uvs[1], uvs[2])
+        ).toConst('cascadeUv')
+
+        If(cascadeIndex.greaterThanEqual(0), () => {
+          const layer = float(cascadeIndex).add(0.5).div(CASCADE_COUNT)
+          const shadow = this.textureNode
+            .sample(vec3(uv, layer))
+            .toConst('beerShadowMapSample')
+          const distanceToFront = max(
+            0,
+            distanceToTop.sub(distanceOffset).sub(shadow.r)
+          )
+          result.assign(
+            min(shadow.b.add(shadow.a), shadow.g.mul(distanceToFront))
+          )
+        })
+      })
+      return result
+    })()
+  }
+
+  // Cloud shadow transmittance at an ECEF position: exp(-opticalDepth).
+  sampleTransmittance(
+    positionECEF: Node<'vec3'>,
+    distanceOffset: Node<'float'> | number = 0
+  ): Node<'float'> {
+    return saturate(
+      exp(this.sampleOpticalDepth(positionECEF, distanceOffset).negate())
+    )
+  }
+
+  // Port of clouds.frag marchShadowLength for cloud god rays: expected
+  // shadowed length along a view ray, where each step contributes
+  // (1 - transmittance) * stepSize from the beer shadow map's optical depth
+  // toward the sun. Additionally accumulates the first moment so the result
+  // can be fitted to the contiguous-segment model the atmosphere runtime's
+  // shadowLength consumes: returns vec2(shadowedLength, segmentStart) in
+  // METERS along the ray (callers convert to unit space).
+  marchShadowLength(
+    rayOriginECEF: Node<'vec3'>,
+    rayDirectionECEF: Node<'vec3'>,
+    maxRayDistance: Node<'float'>,
+    jitter: Node<'float'>,
+    {
+      iterations = 48,
+      minStepSize = 100,
+      stepScale = 1.04
+    }: { iterations?: number; minStepSize?: number; stepScale?: number } = {}
+  ): Node<'vec2'> {
+    return Fn(() => {
+      const shadowed = float(0).toVar('cloudShadowedLength')
+      const moment = float(0).toVar('cloudShadowMoment')
+      const stepSize = float(minStepSize).toVar('cloudShadowStep')
+      const rayDistance = stepSize.mul(jitter).toVar('cloudShadowDistance')
+      Loop(iterations, () => {
+        If(rayDistance.greaterThan(maxRayDistance), () => {
+          Break()
+        })
+        const position = rayOriginECEF.add(rayDirectionECEF.mul(rayDistance))
+        const opticalDepth = this.sampleOpticalDepth(position)
+        const contribution = exp(opticalDepth.negate())
+          .oneMinus()
+          .mul(stepSize)
+        shadowed.addAssign(contribution)
+        moment.addAssign(contribution.mul(rayDistance))
+        stepSize.mulAssign(stepScale)
+        rayDistance.addAssign(stepSize)
+      })
+      const center = moment.div(max(shadowed, 1e-3))
+      const start = max(center.sub(shadowed.mul(0.5)), 0)
+      return vec2(shadowed, start)
+    })()
+  }
+
+  override dispose(): void {
+    this.texture.dispose()
+    super.dispose()
+  }
+}
