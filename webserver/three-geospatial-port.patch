new file mode 100644
index 00000000..2071c5b2
--- /dev/null
+++ b/packages/clouds/src/webgpu/CloudDensityField.ts
@@ -0,0 +1,332 @@
+// TSL port of shaders/clouds.glsl (weather/media sampling) plus the CPU-side
+// parameter/layer uniforms from uniforms.ts, packaged as a reusable object so
+// the shadow pass and the visible cloud raymarch share one density model.
+
+import { Vector2, Vector3, Vector4 } from 'three'
+import {
+  abs,
+  all,
+  asin,
+  atan,
+  clamp,
+  dot,
+  exp,
+  float,
+  greaterThan,
+  length,
+  max,
+  mix,
+  normalize,
+  pow,
+  remapClamp,
+  renderGroup,
+  saturate,
+  select,
+  sqrt,
+  uniform,
+  vec2,
+  vec3,
+  vec4,
+  type ShaderNodeObject
+} from 'three/tsl'
+import type { Node as ThreeNode, TextureNode } from 'three/webgpu'
+
+import type { Node } from '@takram/three-geospatial/webgpu'
+
+import { CloudLayers } from '../CloudLayers'
+
+export interface WeatherSample {
+  heightFraction: Node<'vec4'>
+  density: Node<'vec4'>
+}
+
+export interface MediaSample {
+  weight: Node<'vec4'>
+  scattering: Node<'float'>
+  extinction: Node<'float'>
+}
+
+export interface CloudDensityFieldTextures {
+  localWeatherNode: TextureNode
+  shapeNode: TextureNode
+  shapeDetailNode?: TextureNode | null
+  turbulenceNode?: TextureNode | null
+}
+
+export class CloudDensityField {
+  readonly localWeatherNode: TextureNode
+  readonly shapeNode: TextureNode
+  readonly shapeDetailNode: TextureNode | null
+  readonly turbulenceNode: TextureNode | null
+
+  // Participating medium
+  readonly scatteringCoefficient = uniform(1).setGroup(renderGroup)
+  readonly absorptionCoefficient = uniform(0).setGroup(renderGroup)
+
+  // Weather and shape
+  readonly coverage = uniform(0.3).setGroup(renderGroup)
+  readonly localWeatherRepeat = uniform(new Vector2().setScalar(100)).setGroup(renderGroup)
+  readonly localWeatherOffset = uniform(new Vector2()).setGroup(renderGroup)
+  readonly shapeRepeat = uniform(new Vector3().setScalar(0.0003)).setGroup(renderGroup)
+  readonly shapeOffset = uniform(new Vector3()).setGroup(renderGroup)
+  readonly shapeDetailRepeat = uniform(new Vector3().setScalar(0.006)).setGroup(renderGroup)
+  readonly shapeDetailOffset = uniform(new Vector3()).setGroup(renderGroup)
+  readonly turbulenceRepeat = uniform(new Vector2().setScalar(20)).setGroup(renderGroup)
+  readonly turbulenceDisplacement = uniform(350).setGroup(renderGroup)
+
+  // Cloud layers (packed by updateLayerUniforms)
+  readonly layers = CloudLayers.DEFAULT.clone()
+  readonly minLayerHeights = uniform(new Vector4()).setGroup(renderGroup)
+  readonly maxLayerHeights = uniform(new Vector4()).setGroup(renderGroup)
+  readonly minIntervalHeights = uniform(new Vector3()).setGroup(renderGroup)
+  readonly maxIntervalHeights = uniform(new Vector3()).setGroup(renderGroup)
+  readonly densityScales = uniform(new Vector4()).setGroup(renderGroup)
+  readonly shapeAmounts = uniform(new Vector4()).setGroup(renderGroup)
+  readonly shapeDetailAmounts = uniform(new Vector4()).setGroup(renderGroup)
+  readonly weatherExponents = uniform(new Vector4()).setGroup(renderGroup)
+  readonly shapeAlteringBiases = uniform(new Vector4()).setGroup(renderGroup)
+  readonly coverageFilterWidths = uniform(new Vector4()).setGroup(renderGroup)
+  readonly minHeight = uniform(0).setGroup(renderGroup)
+  readonly maxHeight = uniform(0).setGroup(renderGroup)
+  readonly shadowTopHeight = uniform(0).setGroup(renderGroup)
+  readonly shadowBottomHeight = uniform(0).setGroup(renderGroup)
+  readonly shadowLayerMask = uniform(new Vector4()).setGroup(renderGroup)
+  readonly densityProfileExpTerms = uniform(new Vector4()).setGroup(renderGroup)
+  readonly densityProfileExponents = uniform(new Vector4()).setGroup(renderGroup)
+  readonly densityProfileLinearTerms = uniform(new Vector4()).setGroup(renderGroup)
+  readonly densityProfileConstantTerms = uniform(new Vector4()).setGroup(renderGroup)
+
+  constructor(textures: CloudDensityFieldTextures) {
+    this.localWeatherNode = textures.localWeatherNode
+    this.shapeNode = textures.shapeNode
+    this.shapeDetailNode = textures.shapeDetailNode ?? null
+    this.turbulenceNode = textures.turbulenceNode ?? null
+    this.updateLayerUniforms()
+  }
+
+  // Mirrors updateCloudLayerUniforms() in ../uniforms.ts. Call after
+  // mutating `layers`.
+  updateLayerUniforms(): void {
+    const layers = this.layers
+    layers.packValues('altitude', this.minLayerHeights.value)
+    layers.packSums('altitude', 'height', this.maxLayerHeights.value)
+    layers.packIntervalHeights(
+      this.minIntervalHeights.value,
+      this.maxIntervalHeights.value
+    )
+    layers.packValues('densityScale', this.densityScales.value)
+    layers.packValues('shapeAmount', this.shapeAmounts.value)
+    layers.packValues('shapeDetailAmount', this.shapeDetailAmounts.value)
+    layers.packValues('weatherExponent', this.weatherExponents.value)
+    layers.packValues('shapeAlteringBias', this.shapeAlteringBiases.value)
+    layers.packValues('coverageFilterWidth', this.coverageFilterWidths.value)
+    layers.packDensityProfiles('expTerm', this.densityProfileExpTerms.value)
+    layers.packDensityProfiles('exponent', this.densityProfileExponents.value)
+    layers.packDensityProfiles('linearTerm', this.densityProfileLinearTerms.value)
+    layers.packDensityProfiles(
+      'constantTerm',
+      this.densityProfileConstantTerms.value
+    )
+
+    let totalMinHeight = Infinity
+    let totalMaxHeight = 0
+    let shadowBottomHeight = Infinity
+    let shadowTopHeight = 0
+    const mask = [0, 0, 0, 0]
+    for (let i = 0; i < layers.length; ++i) {
+      const { altitude, height, shadow } = layers[i]
+      const maxHeight = altitude + height
+      if (height > 0) {
+        if (altitude < totalMinHeight) totalMinHeight = altitude
+        if (shadow && altitude < shadowBottomHeight) shadowBottomHeight = altitude
+        if (maxHeight > totalMaxHeight) totalMaxHeight = maxHeight
+        if (shadow && maxHeight > shadowTopHeight) shadowTopHeight = maxHeight
+      }
+      mask[i] = shadow ? 1 : 0
+    }
+    this.minHeight.value = totalMinHeight !== Infinity ? totalMinHeight : 0
+    this.maxHeight.value = totalMaxHeight
+    this.shadowBottomHeight.value =
+      shadowBottomHeight !== Infinity ? shadowBottomHeight : 0
+    this.shadowTopHeight.value = shadowTopHeight
+    this.shadowLayerMask.value.fromArray(mask)
+  }
+
+  // Cube-sphere relaxation by:
+  // http://mathproofs.blogspot.com/2005/07/mapping-cube-to-sphere.html
+  getGlobeUv(position: Node<'vec3'>): Node<'vec2'> {
+    const n = normalize(position).toConst('globeNormal')
+    const f = abs(n).toConst()
+    const c = n.div(max(f.x, max(f.y, f.z))).toConst()
+    const m = select(
+      all(greaterThan(f.yy, vec2(f.x, f.z))),
+      select(c.y.greaterThan(0), vec2(n.x.negate(), n.z), n.xz),
+      select(
+        all(greaterThan(f.xx, vec2(f.y, f.z))),
+        select(c.x.greaterThan(0), n.yz, vec2(n.y.negate(), n.z)),
+        select(c.z.greaterThan(0), n.xy, vec2(n.x, n.y.negate()))
+      )
+    ).toConst('cubeM')
+
+    const m2 = m.mul(m).toConst()
+    const q = dot(m2.xy, vec2(-2, 2)).sub(3).toConst()
+    const q2 = q.mul(q)
+    const uvx = sqrt(
+      float(1.5)
+        .add(m2.x)
+        .sub(m2.y)
+        .sub(sqrt(m2.x.mul(-24).add(q2)).mul(0.5))
+    )
+      .mul(select(m.x.greaterThan(0), 1, -1))
+      .toConst('cubeUvX')
+    const uvy = sqrt(float(6).div(float(3).sub(uvx.mul(uvx)))).mul(m.y)
+    return vec2(uvx, uvy).mul(0.5).add(0.5)
+  }
+
+  insideLayerIntervals(height: Node<'float'>): ShaderNodeObject<ThreeNode> {
+    const gtx = height.greaterThan(this.minIntervalHeights.x)
+    const ltx = height.lessThan(this.maxIntervalHeights.x)
+    const gty = height.greaterThan(this.minIntervalHeights.y)
+    const lty = height.lessThan(this.maxIntervalHeights.y)
+    const gtz = height.greaterThan(this.minIntervalHeights.z)
+    const ltz = height.lessThan(this.maxIntervalHeights.z)
+    return gtx.and(ltx).or(gty.and(lty)).or(gtz.and(ltz))
+  }
+
+  private shapeAlteringFunction(heightFraction: Node<'vec4'>): Node<'vec4'> {
+    // Apply a semi-circle transform to round the clouds towards the top.
+    const biased = pow(heightFraction, this.shapeAlteringBiases)
+    const x = clamp(biased.mul(2).sub(1), -1, 1).toConst()
+    return float(1).sub(x.mul(x))
+  }
+
+  sampleWeather(
+    uv: Node<'vec2'>,
+    height: Node<'float'>,
+    { shadow = false }: { shadow?: boolean } = {}
+  ): WeatherSample {
+    const heightFraction = remapClamp(
+      vec4(height),
+      this.minLayerHeights,
+      this.maxLayerHeights
+    ).toConst('heightFraction')
+
+    // NOTE: The procedural textures have no mips, so the WebGL mipLevel
+    // parameter is dropped here.
+    let localWeather: Node<'vec4'> = pow(
+      this.localWeatherNode
+        .sample(uv.mul(this.localWeatherRepeat).add(this.localWeatherOffset))
+        .rgba,
+      this.weatherExponents
+    )
+    if (shadow) {
+      localWeather = localWeather.mul(this.shadowLayerMask)
+    }
+    localWeather = localWeather.toConst('localWeather')
+
+    const heightScale = this.shapeAlteringFunction(heightFraction).toConst()
+
+    // Modulation to control weather by the coverage parameter.
+    // Reference: https://github.com/Prograda/Skybolt/blob/master/Assets/Core/Shaders/Clouds.h#L63
+    const factor = float(1).sub(this.coverage.mul(heightScale)).toConst()
+    const density = remapClamp(
+      mix(localWeather, vec4(1), this.coverageFilterWidths),
+      factor,
+      factor.add(this.coverageFilterWidths)
+    ).toConst('weatherDensity')
+
+    return { heightFraction, density }
+  }
+
+  private getLayerDensity(heightFraction: Node<'vec4'>): Node<'vec4'> {
+    return this.densityProfileExpTerms
+      .mul(exp(this.densityProfileExponents.mul(heightFraction)))
+      .add(this.densityProfileLinearTerms.mul(heightFraction))
+      .add(this.densityProfileConstantTerms)
+  }
+
+  sampleMedia(
+    weather: WeatherSample,
+    position: Node<'vec3'>,
+    uv: Node<'vec2'>
+  ): MediaSample {
+    let density = weather.density
+
+    // TODO: Define in physical length (upstream TODO as well).
+    const surfaceNormal = normalize(position)
+    const localWeatherSpeed = length(this.localWeatherOffset)
+    const evolution = surfaceNormal
+      .mul(localWeatherSpeed)
+      .mul(-2e4)
+      .toConst('evolution')
+
+    let turbulence: Node<'vec3'> = vec3(0)
+    if (this.turbulenceNode != null) {
+      const turbulenceUv = uv
+        .mul(this.localWeatherRepeat)
+        .mul(this.turbulenceRepeat)
+      turbulence = this.turbulenceNode
+        .sample(turbulenceUv)
+        .rgb.mul(2)
+        .sub(1)
+        .mul(this.turbulenceDisplacement)
+        .mul(
+          dot(density, remapClamp(weather.heightFraction, vec4(0.3), vec4(0)))
+        )
+        .toConst('turbulence')
+    }
+
+    const shapePosition = position
+      .add(evolution)
+      .add(turbulence)
+      .mul(this.shapeRepeat)
+      .add(this.shapeOffset)
+    const shape = this.shapeNode.sample(shapePosition).r.toConst('shape')
+    density = remapClamp(
+      density,
+      vec4(float(1).sub(shape)).mul(this.shapeAmounts),
+      vec4(1)
+    )
+
+    if (this.shapeDetailNode != null) {
+      const detailPosition = position
+        .add(turbulence)
+        .mul(this.shapeDetailRepeat)
+        .add(this.shapeDetailOffset)
+      const detail = this.shapeDetailNode
+        .sample(detailPosition)
+        .r.toConst('shapeDetail')
+      // Fluffy at the top and whippy at the bottom.
+      const modifier = mix(
+        vec4(pow(detail, 6)),
+        vec4(float(1).sub(detail)),
+        remapClamp(weather.heightFraction, vec4(0.2), vec4(0.4))
+      )
+        .mul(this.shapeDetailAmounts)
+        .toConst('detailModifier')
+      density = remapClamp(density.mul(2), modifier.mul(0.5), vec4(1))
+    }
+
+    // Apply the density profiles.
+    density = saturate(
+      density
+        .mul(this.densityScales)
+        .mul(this.getLayerDensity(weather.heightFraction))
+    ).toConst('mediaDensity')
+
+    const densitySum = density.x
+      .add(density.y)
+      .add(density.z)
+      .add(density.w)
+      .toConst('densitySum')
+    const weight = density.div(densitySum).toConst('mediaWeight')
+    const scattering = densitySum
+      .mul(this.scatteringCoefficient)
+      .toConst('mediaScattering')
+    const extinction = densitySum
+      .mul(this.absorptionCoefficient)
+      .add(scattering)
+      .toConst('mediaExtinction')
+    return { weight, scattering, extinction }
+  }
+}
