# Required for Greenland satellite imagery.
DATAFORSYNINGEN_TOKEN=replace-with-your-dataforsyningen-token

# Optional local/operator-only SUPIR enhancement. Do not expose the enhance
# endpoint anonymously in production; put authenticated billing/job control in
# front of it before enabling this flag on a hosted service.
COMFY_URL=http://127.0.0.1:8188
COMFY_ENHANCE_ENABLED=0
# Measured-quality tile ceiling used until the Atlantis fractal upscaler is ready.
TERRAIN_MAX_DEPTH=12
# DEM/satellite source depth used for procedural flora and rock placement.
PROCGEN_SOURCE_DEPTH=12
