#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
PYTHON_BIN="${PYTHON_BIN:-$SCRIPT_DIR/venv/bin/python}"

if [ ! -x "$PYTHON_BIN" ]; then
  echo "Python not found at $PYTHON_BIN"
  echo "Set PYTHON_BIN or ensure flaskserver/venv exists."
  exit 1
fi

cd "$ROOT_DIR"
"$PYTHON_BIN" flaskserver/seam_worker.py 2>&1 | tee "$SCRIPT_DIR/runSeamWorker.log"

